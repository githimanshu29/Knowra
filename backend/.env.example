# Server
PORT=5000
NODE_ENV=development

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_rag_db

# Security & JWT
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# Vector Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# External Model Providers & Observability
OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-rag-intelligence

# Hybrid Retrieval Tuning
LEXICAL_CANDIDATE_K=20
VECTOR_CANDIDATE_K=20
RRF_K_CONSTANT=60
RERANKER_TOP_K=5
FINAL_EVIDENCE_K=3
MAX_CONTEXT_TOKENS=4000
